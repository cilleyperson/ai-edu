datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  sessions      Session[]
  progress      UserProgress?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProgress {
  id                   String   @id @default(cuid())
  userId               String   @unique
  staffCompleted       Boolean  @default(false)
  managementCompleted  Boolean  @default(false)
  boardCompleted       Boolean  @default(false)
  infosecCompleted     Boolean  @default(false)
  engineeringCompleted Boolean  @default(false)
  staffScore           Int      @default(0)
  managementScore      Int      @default(0)
  boardScore           Int      @default(0)
  infosecScore         Int      @default(0)
  engineeringScore     Int      @default(0)
  riskMatrixUsed       Boolean  @default(false)
  playgroundScore      Int      @default(0)
  ragUsed              Boolean  @default(false)
  vendorAudited        Boolean  @default(false)
  embeddingUsed        Boolean  @default(false)
  tokenizerUsed        Boolean  @default(false)
  biasAudited          Boolean  @default(false)
  redteamLvl1          Boolean  @default(false)
  redteamLvl2          Boolean  @default(false)
  warroomUsed          Boolean  @default(false)
  pipelineUsed         Boolean  @default(false)
  agentStudioCompleted Boolean  @default(false)
  xaiCompleted         Boolean  @default(false)
  hitlCompleted        Boolean  @default(false)
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
